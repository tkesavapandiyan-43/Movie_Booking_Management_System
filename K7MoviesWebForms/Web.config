<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Use ASP.NET's built-in validation script (no jQuery needed). Server-side validation still runs. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <connectionStrings>
    <add name="MovieDb"
         connectionString="Server=localhost\SQLEXPRESS;Database=MovieTicketBookingDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" name=".K7AUTH" timeout="480" />
    </authentication>
    <customErrors mode="RemoteOnly" />
  </system.web>
  <!-- pages that need a login -->
  <location path="Seats.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="CancelSeats.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="Receipt.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <location path="MyBookings.aspx"><system.web><authorization><deny users="?" /></authorization></system.web></location>
  <!-- theatre owner pages: TheatreOwner role only -->
  <location path="Owner">
    <system.web>
      <authorization>
        <allow roles="TheatreOwner" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- admin folder: Admin role only -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
